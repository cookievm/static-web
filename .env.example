# Copy this file to .env.local (see README).
# Both values are on Supabase: Project Settings -> API Keys.
# The publishable (anon) key is safe for the browser. The service role key below is secret: leave it empty in this file.
NEXT_PUBLIC_SUPABASE_URL=https://conxuigfvqwguljpjuvd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_6Rii16jlBAtJulo_mrfRMw_7yLxK9JL

# Secret! Supabase: Project Settings -> API Keys -> service_role (or a "secret" key).
# Paste it ONLY into .env.local on your PC and into Vercel's settings. Never share it or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Secret! A password the bot uses to call /api/bot/*. Make one with this PowerShell command and paste it here,
# in Vercel's settings, and in bot/.env:  [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
STATIC_BOT_KEY=

# Secret! Any long random string (the same PowerShell command as above works). Vercel's cron and our Supabase
# pg_cron job send it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/imports.
CRON_SECRET=
